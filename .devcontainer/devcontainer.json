{
    "name": "Multimodal Extraction and Generation",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "hostRequirements": {
        "cpus": 4,
        "storage": "32gb"
    },
    "secrets": {
        "OPENAI_API_KEY": {
            "description": "Your OpenAI API key for the course exercises."
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "Brodazz.mp4-player"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "workbench.colorTheme": "Default Dark+",
                "editor.rulers": [
                    80
                ],
                "workbench.iconTheme": "vs-seti",
                "workbench.editorAssociations": {
                    "*.mp4": "mp4Player.preview",
                    "*.md": "vscode.markdown.preview.editor"
                }
            }
        },
        "codespaces": {
            "openFiles": [
                "README.md"
            ]
        }
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && python -m pip install -r requirements.txt"
}
