{
    "name": "Multimodal Extraction and Generation",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "hostRequirements": {
        "cpus": 4,
        "storage": "32gb"
    },
    "secrets": {
        "OPENAI_API_KEY": {
            "description": "Your OpenAI API key for the course exercises."
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            }
        },
        "codespaces": {
            "openFiles": [
                "README.md",
                "01_Image_Extraction/image_extraction.ipynb"
            ]
        }
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && python -m pip install -r requirements.txt"
}
